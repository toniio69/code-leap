{
  "git.ignoreLimitWarning": true,
  "php.version": "8.5",
  "sqltools.connections": [
    {
      "mysqlOptions": {
        "authProtocol": "default",
        "enableSsl": "Disabled"
      },
      "ssh": "Disabled",
      "previewLimit": 50,
      "server": "localhost",
      "port": 3308,
      "driver": "MariaDB",
      "name": "Codeleap",
      "group": "127.0.0.1",
      "database": "Codeleap",
      "username": "root"
    }
  ],
  "CodeGPT.apiKey": "CodeGPT Plus Beta",
  "intelephense.environment.includePaths": [
    "${workspaceFolder}/vendor"
  ],
  "intelephense.files.exclude": [
    "**/.git/**",
    "**/.svn/**",
    "**/.hg/**",
    "**/CVS/**",
    "**/.DS_Store/**",
    "**/Thumbs.db/**",
    "**/node_modules/**"
  ]
}
